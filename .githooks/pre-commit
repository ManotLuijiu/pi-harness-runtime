#!/bin/bash
# Pre-commit hook to check React component file sizes
# Blocks commits for React files exceeding 300 lines
# Use --no-verify to bypass (rare exceptions only)

MAX_LINES=300
YELLOW_LINES=150

echo "Checking React component file sizes..."

# Find staged .tsx files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx|jsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No React files staged, skipping size check."
    exit 0
fi

BLOCKED=0
WARNINGS=0

for file in $STAGED_FILES; do
    if [ ! -f "$file" ]; then
        continue
    fi

    LINES=$(wc -l < "$file")

    # Skip empty files
    if [ "$LINES" -eq 0 ]; then
        continue
    fi

    # Check for React components (files with function/class declarations or default exports)
    if grep -qE '(function [A-Z]|const [A-Z]|export default|React\.Component|useState|useEffect)' "$file" 2>/dev/null; then
        if [ "$LINES" -gt "$MAX_LINES" ]; then
            echo "🔴 BLOCKED: $file ($LINES lines) - exceeds $MAX_LINES lines"
            BLOCKED=$((BLOCKED + 1))
        elif [ "$LINES" -gt "$YELLOW_LINES" ]; then
            echo "🟡 WARNING: $file ($LINES lines) - consider extracting sub-components (> $YELLOW_LINES lines)"
            WARNINGS=$((WARNINGS + 1))
        fi
    fi
done

echo ""
if [ "$BLOCKED" -gt 0 ]; then
    echo "❌ $BLOCKED file(s) blocked - React components exceeding $MAX_LINES lines"
    echo "   Extract sub-components before committing."
    echo "   Use --no-verify to bypass (rare exceptions only)."
    exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
    echo "⚠️  $WARNINGS file(s) with warnings - consider extracting sub-components"
fi

echo "✅ React component size check passed"
exit 0
