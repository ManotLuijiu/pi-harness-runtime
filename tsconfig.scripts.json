{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.d.mts"],
  "exclude": ["scripts/release/**"]
}
