node_modules/
*.log
.DS_Store
# Local secrets and environment overrides
.env
.env.*
.env.local
.env.*.local
.env.test
# Local SQLite state (created at runtime in ~/.pi/usage-status/)
# This file lives outside the repo; nothing to ignore here.
sample_github_workflows/

# Open Knowledge Format (local knowledge base)
OKF/

# Wiki data directories (kept private, per-user)
# Note: packages/wiki/ package IS committed via negation below
wiki/

# Exception: wiki package (code) is tracked
!packages/wiki/
.npmrc

# Skills sync staging — private generated content (manifests/ IS committed)
harness/skills-staging/source-mirror/
harness/skills-staging/sanitized-candidates/
harness/skills-staging/reports/

# Source JS files (should be in dist/, not src/)
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map
packages/*/src/*.js.map


# Build outputs
.pi-subagents/
harness/skills-plan/ACTION-PLAN-DAYS-3-PLUS.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.write-review/
.pi/
.pi/skills/release/*
.pi-glla/

# The package ships exactly one skill: its own, `skills/harness-runtime/`.
# Every other skill payload lives in the user's own Qdrant collection and in
# the installation-local skill store, so it is never committed.
# The runtime implementation lives in packages/skills/ and stays tracked.
/skills/*
!/skills/harness-runtime/
/.agents/skills/
/.claude/skills/

# Harness generated type/sourcemap files (JS is committed; type files are build artifacts)
harness/*.d.ts
harness/*.d.ts.map
harness/*.js.map
harness/e2e/*.d.ts
harness/e2e/*.d.ts.map
harness/e2e/*.js.map
cli.d.ts
cli.d.ts.map
cli.js.map

# Build outputs for harness non-langchain dirs (langchain/*.js IS committed)
harness/*.js
!harness/langchain/
harness/langchain/*.js
harness/e2e/*.js

# Root mirror build artifacts
mirror.d.ts
mirror.d.ts.map
mirror.js.map

# Project detector build artifacts
harness/project-detector/*.d.ts
harness/project-detector/*.d.ts.map
harness/project-detector/*.js.map
cli.js
mirror.js

# pi-lens
.pi-lens/

# Compiled artifacts must never live next to a TypeScript source: Bun
# resolves the literal .js file first, so a stale artifact shadows the
# current source.
harness/**/*.d.ts.map
harness/**/*.js.map
scripts/**/*.d.ts.map
scripts/**/*.js.map

# Incremental build state of a composite project is local build state,
# never a tracked release artifact.
*.tsbuildinfo

# Test fixtures that live in the workspace instead of the shared /tmp
.test-two-phase-root-*
packages/two-phase-review/.test-*

# generated code-graph output (a tool snapshot, not source)
/graphify-out/
