harness/e2e/*.d.ts.map
harness/e2e/*.js.map
cli.d.ts
cli.d.ts.map
cli.js.map

# Build outputs for harness non-langchain dirs (langchain/*.js IS committed)
harness/*.js
!harness/langchain/
harness/langchain/*.js
harness/e2e/*.js

# Root mirror build artifacts
mirror.d.ts
mirror.d.ts.map
mirror.js.map

