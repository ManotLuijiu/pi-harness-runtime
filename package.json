{
  "name": "pi-harness-runtime",
  "version": "1.1.190",
  "description": "[BETA] Codex-style /usage status + autonomous coding harness for pi. Not production ready — expect breaking changes.",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-root-tests.mjs",
    "test:node:built": "node --test \"test/**/*.test.mjs\" \"packages/clipboard/test/*.test.mjs\"",
    "typecheck": "node scripts/typecheck-packages.mjs",
    "postinstall": "mkdir -p ~/.pi-harness-runtime/cookies && node scripts/copy-plugins.js && ([ -f ~/.config/herdr/config.toml ] || mkdir -p ~/.config/herdr && cp config.toml.example ~/.config/herdr/config.toml)",
    "release": "bun scripts/release-all.ts",
    "release:patch": "bun scripts/release-all.ts --release-as patch",
    "release:minor": "bun scripts/release-all.ts --release-as minor",
    "release:major": "bun scripts/release-all.ts --release-as major",
    "release:dry-run": "bun scripts/release-all.ts --dry-run",
    "auth:minimax": "bun packages/auth/src/run-minimax-auth.ts auth",
    "auth:minimax:check": "bun packages/auth/src/run-minimax-auth.ts check",
    "auth:minimax:scrape": "bun packages/auth/src/run-minimax-auth.ts scrape",
    "skills:sync": "bun scripts/skills-sync.ts",
    "skills:sync:check": "bun scripts/skills-sync.ts --check-only",
    "build": "bun scripts/build-packages.ts",
    "build:verify": "bun scripts/verify-package-contents.ts",
    "build:verify:pack": "bun scripts/verify-package-contents.ts --pack",
    "prepublishOnly": "bun run build && bun run build:verify:pack",
    "test:harness": "node scripts/run-langchain-tests.mjs",
    "test:packages": "bun test packages/",
    "test:e2e": "PI_HARNESS_E2E=1 bun test e2e/",
    "test:e2e:scripts": "node scripts/run-e2e-scripts.mjs",
    "test:all": "npm run test && npm run test:harness",
    "prepublish": "bun run build"
  },
  "bin": {
    "harness-auth": "packages/auth/src/run-minimax-auth.ts"
  },
  "files": [
    "*.ts",
    "*.md",
    "harness/**/*.ts",
    "packages/**/src/**/*.{ts,js}",
    "packages/**/dist/**/*.{js,d.ts,js.map,d.ts.map}",
    "prompts/**/*",
    "scripts/**/*",
    "plugins/**/*",
    "package.json",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.toml.example"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "usage",
    "tokens",
    "cost",
    "codex"
  ],
  "author": "MooCoding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManotLuijiu/pi-harness-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/ManotLuijiu/pi-harness-runtime/issues"
  },
  "homepage": "https://github.com/ManotLuijiu/pi-harness-runtime#readme",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "pi-mcp-adapter": ">=6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.4.3",
    "husky": "^9.1.7",
    "playwright": "^1.62.0",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@earendil-works/chord": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/openai": "^1.5.10",
    "@qdrant/js-client-rest": "^1.20.0",
    "chokidar": "^5.0.0",
    "deepagents": "^1.10.5",
    "langchain": "^1.5.10",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "pi-mcp-adapter": {
      "optional": true
    }
  }
}
